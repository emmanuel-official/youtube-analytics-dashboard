# Copy this file to .streamlit/secrets.toml for LOCAL use only.
# NEVER commit the real secrets.toml file to GitHub — it's already
# listed in .gitignore.
#
# For your deployed app on Streamlit Community Cloud, don't use this
# file at all — paste this same line into:
#   App → Settings → Secrets  (in the Streamlit Cloud dashboard)

YOUTUBE_API_KEY = "paste_your_own_key_here"
